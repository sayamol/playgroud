# ------------------------------------------------------------------
# Retirement Land Finder - environment configuration
# Copy this file to  .env  (project root) and adjust as needed.
# The app runs fine with NO .env file at all (sensible defaults).
# ------------------------------------------------------------------

# Port the API/back-end listens on. The Vite dev server proxies /api here.
PORT=5175

# ---- Live listing scrapers (DDproperty / Kaidee / Baania) ----------
# These sites actively block bots. Without a residential proxy /
# unblocker they will mostly fail. Everything else in the app still
# works (seed data + real government appraisal lookups).

# Master switch for the SCHEDULED crawler. OFF by default on purpose.
# Set to "true" only if you understand it may get your IP rate-limited
# or banned by those sites.
ENABLE_CRAWLER=false

# node-cron expression for the scheduled crawler (default: 03:15 daily).
CRAWLER_CRON=15 3 * * *

# Polite delay between individual scraper page loads, milliseconds.
SCRAPER_DELAY_MS=6000

# Max listings to pull per (source, region) per run.
SCRAPER_MAX_PER_RUN=25

# Optional proxy for Playwright (Bright Data / Oxylabs / your own).
# Leave blank to run direct (will likely be blocked).
# Example: http://brd.superproxy.io:22225
SCRAPER_PROXY_URL=
SCRAPER_PROXY_USER=
SCRAPER_PROXY_PASS=

# ---- Government appraisal (Treasury Dept. / กรมธนารักษ์) -----------
# Real data source, no API key. The ArcGIS host itself needs a token, so
# calls are routed through the Treasury site's own public proxy.
TREASURY_MAPSERVER=https://p-gis.treasury.go.th/arcgis/rest/services/TD_FORMER/TD_Former_Staff_ViewData/MapServer
TREASURY_PROXY=https://assessprice.treasury.go.th/assessprice/ashx/Proxy.ashx?

# Reverse-geocoder used to resolve a point -> Thai province so the
# right parcel layer is queried. OSM Nominatim is free; set a contact
# string per their usage policy.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=you@example.com

# If the Treasury lookup fails, fall back to a heuristic price model.
APPRAISAL_HEURISTIC_FALLBACK=true
